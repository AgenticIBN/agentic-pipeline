GROQ_API_KEY=replace_with_your_key
GROQ_MODEL=openai/gpt-oss-120b
AGNO_RUNTIME=agno
DEFAULT_SCENARIO=urban_area
MODEL_REGISTRY_FILE=config/model_registry.json
RESULTS_DIR=results
ACTIVE_STATE_FILE=state/active_intents.json
MAX_OPTIMIZATION_ITERATIONS=3
OPTIMIZATION_CANDIDATES_PER_ROUND=4
OPTIMIZATION_HISTORY=full
# Optional: cap on estimated tokens sent to the Optimization Agent (e.g. 6000 for Groq free tier)
OPTIMIZATION_PROMPT_TOKEN_BUDGET=
